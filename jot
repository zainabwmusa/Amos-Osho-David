.contact-form{
  background: transparent; backdrop-filter: blur(50px); margin-bottom: 3em; padding: 2em 2em 3em 2em; border-radius: 16px; min-width: 450px; max-width: 850px; box-shadow: 0 4px 24px rgba(0,0,0,0.18); color: #fff; display: flex; flex-direction: column; gap: 1em;
}

.contact-form h2{
  margin-bottom: 0.5em; color: #ff7707; font-size: 2em;
}

.contact-form input{
  padding: 0.7em; border-radius: 8px; border: none; margin-bottom: 0.5em; background-color: #ffffffc4;
}

.contact-form textarea{
  padding: 0.7em; border-radius: 8px; border: none; margin-bottom: 0.5em; background-color: #ffffffb8;
}

.contact-form button{
  background: linear-gradient(90deg, #ff7707 60%, #000000 100%); color: #fff; border: none; border-radius: 8px; padding: 0.7em 1.5em; font-weight: 600; cursor: pointer; transition-duration: 1s;
}

.contact-form input:focus, .contact-form textarea:focus{
  outline: 1px solid #ff7707;
}

.contact-form button:hover{
  scale: 1.05;
}

.contact-form label{
  font-size: 1.2em;
}

<form class="contact-form">
           <h2>Contact Form</h2>
           <label for="name">Name</label>
           <input placeholder="Your Name" type="text" id="name" name="name" required>
           <label for="email">Email</label>
           <input placeholder="Your Email" type="email" id="email" name="email" required>
           <label for="message">Message</label>
           <textarea placeholder="What do want to talk about." id="message" name="message" rows="4" required></textarea>
           <button type="submit">Send Message</button>
         </form>